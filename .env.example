# Open WebUI connection (required)
OPENWEBUI_BASE_URL=http://localhost:8080
OPENWEBUI_API_KEY=sk-...

# Optional: require a bearer token on the MCP endpoint itself
# OPENWEBUI_MCP_TOKEN=change-me

# Optional: transport (stdio | sse | streamable-http)
# OPENWEBUI_MCP_TRANSPORT=stdio

# Optional: chat timeout in ms
# OWUI_TIMEOUT_MS=120000
